# two_pixel_prob_dotgrid.py
# Probability for each (n1, n2) after a chosen two-pixel weak-measurement record (h1, h2).

# Install dependencies (only needed in Colab or first-time use)
!pip install qutip

import numpy as np, math, matplotlib.pyplot as plt
from qutip import Qobj

# ----------- experiment parameters -----------
N = 30                          # total electrons
p0, p1, p2 = 0.5, 0.25, 0.25    # pre-measurement splitting (left, pixel1, pixel2)
sigma = 0.5                     # measurement noise std
chi = 1.0/(2.0*sigma**2)        # Gaussian strength
h1, h2 = int(round(N*p1)), int(round(N*p2))   # chosen measurement record (edit as you like)

# ----------- fixed-N basis (n1,n2) with n0=N-n1-n2 -----------
states = [(n1, n2) for n1 in range(N+1) for n2 in range(N+1-n1)]
dim = len(states)
n1_diag = np.array([n1 for (n1, n2) in states], float)
n2_diag = np.array([n2 for (n1, n2) in states], float)
n0_diag = N - n1_diag - n2_diag

# multinomial input amplitudes |psi0>
lg = np.array([math.lgamma(k+1) for k in range(N+1)])
amps = np.zeros(dim, float)
for i,(n1v,n2v) in enumerate(states):
    n0v = N - n1v - n2v
    log_mult = lg[N] - (lg[n0v] + lg[n1v] + lg[n2v])
    amps[i] = math.exp(0.5*log_mult) * (p0**(n0v/2)) * (p1**(n1v/2)) * (p2**(n2v/2))
amps /= np.linalg.norm(amps)
psi0 = Qobj(amps)

# two-pixel weak measurement (condition on record h1,h2)
diag = np.exp(-0.5*chi*((n1_diag - h1)**2 + (n2_diag - h2)**2))
M = Qobj(np.diag(diag))
psi_post = (M*psi0).unit()
prob = np.abs(psi_post.full().ravel())**2

# ----------- plot: mentor’s dot-grid -----------
# x: n1 (arm/pixel 1), y: n2 (arm/pixel 2); color = posterior probability
plt.figure(figsize=(7,6.5))
# place dots on integer lattice, masking forbidden n1+n2>N
for n1v in range(N+1):
    for n2v in range(N+1):
        if n1v + n2v <= N:
            idx = states.index((n1v, n2v))
            plt.scatter(n1v, n2v, c=[prob[idx]], cmap='viridis', vmin=0, vmax=prob.max(),
                        s=140, edgecolors='k', linewidths=0.3)

# triangular boundary of allowed region
plt.plot([0, N, 0, 0], [0, 0, N, 0], 'k-', lw=1.2)
cbar = plt.colorbar()
cbar.set_label(r'Posterior probability  $|c_{n_1,n_2}^{(h_1,h_2)}|^2$')
plt.title(f'Two-pixel probability (post-measurement)   h₁={h1}, h₂={h2}, N={N}')
plt.xlabel('number in arm / pixel 1 (n₁)')
plt.ylabel('number in arm / pixel 2 (n₂)')
plt.xlim(-0.5, N+0.5); plt.ylim(-0.5, N+0.5); plt.gca().set_aspect('equal', adjustable='box')
plt.tight_layout(); plt.show()
